# ---- Copy to .env and fill in. NEVER commit .env. ----
# RPC endpoints (comma separated, tried in order)
RPC_URLS=https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io

# ---- Projects: one service can watch several mints at once. ----
# Set PROJECTS_JSON to a JSON array (one line) to enable multi-project mode.
# Each project: id, label, mintContract, token, pair, eventTopic0,
# minterTopicIndex, referrerTopicIndex, operatorReferrer, sharesLocation,
# requiredShares, registrationTtlHours, maxPayoutUsdtPerDay, tierPriceBnb,
# referralBps, guardFactor, pricing { mode: fixed|dynamic, baseUsdt,
# tiers: [[minTotalMinted, priceUsdt], ...], poolFloorBnb, poolFloorUsdt }.
# If PROJECTS_JSON is empty, the service runs in legacy single-project mode
# using the MINT_CONTRACT / TIER_PRICE_BNB / ... vars below (Agent ID $AI).
#
# Example (Agent ID $AI + BIBI, values verified on-chain 2026-11-23):
# PROJECTS_JSON=[{"id":"agentid","label":"Agent ID $AI","mintContract":"0xa4bFa31f615F8e2a13dce3d93C0996CC5a56763D","token":"0x2a60AaB19b182B5C4b47fffC066ADA06Ab27924f","pair":"0x6c3d8b927B8c38d5907aE64b17804871c97CEf97","eventTopic0":"0x6002eca610a8cf3698284c97c6ded788f652ebd60c7aaaa4a00d68f538ae73d0","minterTopicIndex":1,"referrerTopicIndex":3,"operatorReferrer":"","sharesLocation":"data:1","requiredShares":10,"registrationTtlHours":24,"maxPayoutUsdtPerDay":"500","tierPriceBnb":"0.008","referralBps":1500,"guardFactor":0.9,"pricing":{"mode":"fixed","baseUsdt":"5.45"}},{"id":"bibi","label":"BIBI","mintContract":"0x3ee0570567625D90a5DEE11290F159D4AaCD29C6","token":"0x6fC563428B3D6CdD151cB57f0CA5859615C02260","pair":"0x63b6a0f72fDA65684Db2aD6e60968c0ab0b22391","eventTopic0":"0x6002eca610a8cf3698284c97c6ded788f652ebd60c7aaaa4a00d68f538ae73d0","minterTopicIndex":1,"referrerTopicIndex":3,"operatorReferrer":"0xdB876cD9450f6407c93E3E7200edf2eA58C87521","sharesLocation":"data:1","requiredShares":10,"registrationTtlHours":24,"maxPayoutUsdtPerDay":"500","tierPriceBnb":"0.0028","referralBps":500,"guardFactor":0.9,"pricing":{"mode":"dynamic","baseUsdt":"0.40","tiers":[[13000,"0.75"]],"poolFloorBnb":20,"poolFloorUsdt":"0.70"}}]
PROJECTS_JSON=

# Mint contract to watch (default: Agent ID $AI mint)
MINT_CONTRACT=0xa4bFa31f615F8e2a13dce3d93C0996CC5a56763D

# Mint event signature, e.g. Mint(address,uint256,uint256).
# For Agent ID $AI the event name is not published, so the raw topic0 hash
# is used instead (MINT_EVENT_TOPIC0). Verified from real mint txs
# 0x9766d69a12f4d72a9f9a65eced33ce48d033578b48b8bd137b496cbd171be9c9 (block
# 135110404) and 0x613fe22f28a7a67f4577e67bfdcd0939f195f5eae280e7f69c25307d294ff45a
# (block 135110503): the summary event has topics [sig, minter, agentId,
# referrer] and data words [totalMintedBefore, shares, poolBnb, rebateBnb,
# platformBnb]. The listener refuses to pay live while this is empty.
MINT_EVENT_TOPIC0=0x6002eca610a8cf3698284c97c6ded788f652ebd60c7aaaa4a00d68f538ae73d0
MINT_EVENT_SIGNATURE=
# Which indexed topic holds the minter address (0 = topic0 is the event itself, so 1 = first indexed arg)
MINT_MINTER_TOPIC_INDEX=1
# Which indexed topic holds the referrer address (3 for Agent ID $AI).
# OPERATOR_REFERRER: your own referrer address. Mints via any other
# referrer are ignored (no rebate for them). Leave empty to accept all.
MINT_REFERRER_TOPIC_INDEX=3
OPERATOR_REFERRER=
# Where the share count lives: "data:<word>" (0-based 32-byte word in log data)
# or "topic:<index>". For Agent ID $AI: second data word.
MINT_SHARES_LOCATION=data:1
# Scan mode: receipts (default, works on free RPCs, catches routed mints),
# blockscan (direct txs only) or getlogs (needs a log-capable RPC).
LOG_MODE=receipts

# Payout token (BSC USDT, 18 decimals on BSC - NOT 6 like Ethereum)
PAYOUT_TOKEN=0x55d398326f99059fF775485246999027B3197955
PAYOUT_TOKEN_DECIMALS=18
# Fixed USDT paid per qualified mint (one payout per minter per registration)
PAYOUT_USDT_PER_MINT=5.45
# Shares a minter must mint in one go to qualify
REQUIRED_SHARES=10
# Registration validity, hours
REGISTRATION_TTL_HOURS=24
# Max total USDT paid per calendar day (UTC)
MAX_PAYOUT_USDT_PER_DAY=500

# Economics guard: expected referral rebate = shares * TIER_PRICE_BNB * BNB price * REFERRAL_BPS.
# Verified on Agent ID $AI (2026-11-23, totalMinted ~259,700): a 10-share mint
# cost 0.08 BNB, summary event word2 = 0.08 BNB, word3 (rebate) = 0.012 BNB
# = 10 x 0.008 x 15%. So TIER_PRICE_BNB = 0.008 is the base tier price at
# that mint count; it rises as totalMinted grows. Payout is refused when it
# exceeds EXPECTED * GUARD_FACTOR. If TIER_PRICE_BNB is empty, the guard
# cannot compute and live payouts stay disabled unless ECONOMICS_GUARD=false
# (not recommended).
TIER_PRICE_BNB=0.008
REFERRAL_BPS=1500
GUARD_FACTOR=0.9
ECONOMICS_GUARD=true

# Listener
POLL_INTERVAL_MS=10000
CONFIRMATIONS=1

# Hot wallet. Private key ONLY via environment, never in a file.
# The wallet only needs USDT + a little BNB for gas.
HOT_WALLET_PRIVATE_KEY=
# Dry run: true = log what WOULD be paid, send nothing. Default true. Set false to go live.
DRY_RUN=true

# HTTP API
PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
